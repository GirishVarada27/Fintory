DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
FIXER_API_KEY=replace-with-a-fixer.io-access-key
GEMINI_API_KEY=replace-with-a-gemini-api-key
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
# Optional — omit to leave Plaid linking stubbed (routes respond "not configured")
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Optional — omit to leave receipt photo storage as a non-durable data: URL stub
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
